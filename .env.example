# Copy this file to .env and fill in values as needed.
OPENAI_API_KEY=
CIVIL_CODE_RAG_CORPUS_PATH=data/processed/articles.jsonl
CIVIL_CODE_RAG_INDEX_DIR=data/index
CIVIL_CODE_RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
CIVIL_CODE_RAG_LLM_MODEL=gpt-4.1-mini
# Client ID -> API key (JSON). Callers send the key in the X-API-Key header.
# Replace this local demo key before running anywhere shared.
CIVIL_CODE_RAG_API_KEYS={"local-demo":"local-demo-key-change-me"}
# Optional JSON-lines audit file, written in addition to stdout.
# CIVIL_CODE_RAG_AUDIT_LOG_PATH=outputs/audit/audit.jsonl
